msgstr "Nie udało się pobrać i zainstalować gusnet_epanet. {exception}"

#: gusnet/dependencies.py:145
#, python-brace-format
msgid "Missing necessary python packages {missing_deps}. Please see help for how to fix this"
msgstr ""
"Brakuje wymaganych pakietów Pythona: {missing_deps}. Informacje o rozwiązaniu problemu znajdują "
"się w pomocy."

#: gusnet/dependencies.py:153
msgid "Fetching gusnet_epanet is already in progress. Please wait and try again."
msgstr "Pobieranie gusnet_epanet już trwa. Poczekaj i spróbuj ponownie."

