msgstr "Udział objętości zbiornika dla dwukomorowego modelu mieszania"

#: gusnet/elements.py:744
msgid "Tank mixing model type for water quality analysis"
msgstr "Typ modelu mieszania w zbiorniku dla analizy jakości wody"

#: gusnet/elements.py:746
msgid "Bulk reaction rate coefficient for water quality analysis"
msgstr "Współczynnik szybkości reakcji w objętości dla analizy jakości wody"

#: gusnet/elements.py:748
msgid "Wall reaction rate coefficient for water quality analysis"
msgstr "Współczynnik szybkości reakcji przy ścianie dla analizy jakości wody"

#: gusnet/elements.py:750
