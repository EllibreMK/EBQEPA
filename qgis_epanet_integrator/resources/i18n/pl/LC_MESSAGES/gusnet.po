#: gusnet/api.py:67
#, python-brace-format
msgid "No units specified. Will use the value from wn: {units_friendly_name}"
msgstr "Nie określono jednostek. Zostanie użyta wartość z wn: {units_friendly_name}"

#: gusnet/api.py:197
msgid ""
"Cannot set headloss formula when wn is set. Set the headloss in the wn.options.hydraulic.headloss"
" instead"
msgstr ""
"Nie można ustawić wzoru strat hydraulicznych, gdy ustawiono wn. Zamiast tego ustaw wzór w "
"wn.options.hydraulic.headloss."

#: gusnet/api.py:207
msgid "headloss must be set if wn is not set: possible values are: H-W, D-W, C-M"
msgstr ""
"Jeżeli wn nie jest ustawione, należy ustawić wzór strat hydraulicznych. Możliwe wartości: H-W, "
"D-W, C-M"

#: gusnet/api.py:219
msgid "No valid CRS found on input layers. Pipe lengths will not be calculated."
msgstr ""
"Na warstwach wejściowych nie znaleziono prawidłowego układu współrzędnych. Długości przewodów nie"
" zostaną obliczone."

#: gusnet/api.py:222
msgid "Some input layers do not have a valid CRS. Pipe lengths may not be calculated correctly."
msgstr ""
"Niektóre warstwy wejściowe nie mają prawidłowego układu współrzędnych. Długości przewodów mogą "
"zostać obliczone nieprawidłowo."

#: gusnet/api.py:225
msgid "Multiple different CRSs found on input layers."
msgstr "Na warstwach wejściowych znaleziono kilka różnych układów współrzędnych."

#: gusnet/api.py:264
#, python-brace-format
msgid "CRS {crs} is not valid."
msgstr "Układ współrzędnych {crs} jest nieprawidłowy."

#: gusnet/api.py:270
#, python-brace-format
msgid "{exception} is not a known set of units. Possible units are: "
msgstr "{exception} nie jest rozpoznanym zestawem jednostek. Możliwe jednostki: "

#: gusnet/api.py:279
#, python-brace-format
msgid ""
"{value_error}. Only acceptable layer types are 'JUNCTIONS', 'RESERVOIRS', 'TANKS', 'PIPES', "
"'VALVES', 'PUMPS'."
msgstr ""
"{value_error}. Dopuszczalne typy warstw to wyłącznie: 'JUNCTIONS', 'RESERVOIRS', 'TANKS', "
"'PIPES', 'VALVES', 'PUMPS'."

#: gusnet/dependencies.py:36
msgid "Fetching EPANET"
msgstr "Pobieranie EPANET"

#: gusnet/dependencies.py:114
msgid "Took too long to fetch and install."
msgstr "Pobieranie i instalowanie trwało zbyt długo."

#: gusnet/dependencies.py:117
msgid "Couldn't find Python"
msgstr "Nie znaleziono Pythona"

